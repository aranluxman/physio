# Copy to .env.local for local development (never commit .env.local).
# Supabase Dashboard -> Project Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (starts with sb_publishable_). Safe to ship in the
# browser bundle — row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Older projects issue a JWT "anon" key instead. Either variable works; set one.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
